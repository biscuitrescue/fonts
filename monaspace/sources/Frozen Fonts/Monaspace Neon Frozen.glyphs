@plus = [plus plus.init plus.medi plus.fina];
@numbersign = [numbersign numbersign.init numbersign.medi numbersign.fina];
@equal = [equal equal.medi];
@underscore = [underscore underscore.left underscore.right underscore.both underscore.longboth underscore.longleft underscore.longright at_underscore];
@underscoredbl = [underscoredbl underscoredbl.left underscoredbl.right underscoredbl.both underscoredbl.longboth underscoredbl.longleft underscoredbl.longright];

@math = [leftwhitesquarebracket-math rightwhitesquarebracket-math leftanglebracket-math rightanglebracket-math leftdoubleanglebracket-math rightdoubleanglebracket-math hyphen_hyphen_greater hyphen_greater hyphen_asciitilde braceleft_bar bracketleft_bracketright bracketleft_bar exclam_equal exclam_equal_equal exclam_asciitilde numbersign_parenleft numbersign_bracketleft numbersign_exclam_bracketleft numbersign_equal slash_equal slash_equal_equal exclam_equal.alt periodcentered bullet asterisk asterisksmall bracketleftwithquill bracketrightwithquill dblverticalbar asterisk.six asterisksmall.six hyphen softhyphen endash emdash figuredash horizontalbar hyphentwo parenleft parenright braceleft braceright bracketleft bracketright angleLeft angleRight braceleft.full braceright.full heavyleftpointinganglebracketornament heavyleftpointinganglequotationmarkornament heavyrightpointinganglebracketornament heavyrightpointinganglequotationmarkornament leftCeiling leftFloor leftanglebracketdot leftwhitecurlybracket rightCeiling rightFloor rightanglebracketdot rightwhitecurlybracket znotationleftbindingbracket znotationleftimagebracket znotationrightbindingbracket znotationrightimagebracket ampersand_equal bar_braceright bar_bracketright bar_bar bar_greater equal_exclam_equal equal_equal equal_equal_equal equal_equal_greater equal_greater equal_greater_greater equal_less_less equal_asciitilde equal_slash_equal greater_equal greater_greater greater_greater_equal less_hyphen less_hyphen_hyphen less_hyphen_hyphen_greater less_hyphen_greater less_exclam_hyphen_hyphen less_bar less_bar_greater less_equal less_equal_equal less_equal_equal_greater less_equal_greater less_greater less_less less_less_equal less_asciitilde less_asciitilde_greater less_asciitilde_asciitilde less_slash less_slash_greater asciitilde_hyphen asciitilde_greater asciitilde_asciitilde asciitilde_asciitilde_greater less_equal.alt greater_equal.angle less_equal.angle APLbackslashbar APLcirclebackslash APLcircledieresis APLcirclejot APLcirclestar APLcirclestile APLcircleunderbar APLcommabar APLdiamondunderbar APLdowncarettilde APLdownvane APLgreaterthandieresis APLjotdieresis APLjotunderbar APLleftvane APLquad APLquadbackslash APLquadcircle APLquadcolon APLquaddel APLquaddelta APLquaddiamond APLquaddivide APLquaddownarrow APLquaddowncaret APLquadequal APLquadgreaterthan APLquadjot APLquadleftarrow APLquadlessthan APLquadnotequal APLquadquestion APLquadrightarrow APLquadslash APLquaduparrow APLquadupcaret APLquotequad APLquoteunderbar APLrightvane APLslashbar APLsquishquad APLstardieresis APLstiletilde APLtildedieresis APLupcarettilde APLupvane APLzilde GturnedSansSerif LreversedSansSerif LturnedSansSerif Ohminverted YturnedSansSerif acuteAngle almostequalorequalto ampersandturned andWithDot angleWithUnderbar anticlockwiseClosedCircleArrow approaches approxequalorimage approximatelybutnotactuallyequalto assertion asteriskmath asymptoticallyequal because between blackBowtie blackCircleWithDownArrow blackDiamondWithDownArrow blackHourglass blackLozenge bowtie bowtieWithLeftHalfBlack bowtieWithRightHalfBlack bulletoperator circleDividedByHorizontalBarAndTopHalfDividedByVerticalBar circleSmallCircleRight circleTwoHorizontalStrokesRight circleWithHorizontalBar circleWithSuperimposedX clockwiseClosedCircleArrow colonequals congruent containsasmemberSmall containsasnormalsubgroup containsasnormalsubgrouporequalto cuberoot diamondoperator divides divisiontimes doesnotcontainasnormalsubgroup doesnotcontainasnormalsubgrouporequal doesnotprecedeorequal doesnotsucceedorequal dotmath dotminus dotplus dottedFence doubleLineEqualToOrGreaterThan doubleLineEqualToOrLessThan doubleLineSlantedEqualToOrGreaterThan doubleLineSlantedEqualToOrLessThan doubleLineSlantedGreaterThanOrEqualTo doubleLineSlantedLessThanOrEqualTo doubleLogicalAnd doubleLogicalOr doubleNestedGreaterThan doubleNestedLessThan doubleNestedLessThanWithUnderbar doublePrecedes doubleSolidusOperator doubleSucceeds downTriangleWithLeft