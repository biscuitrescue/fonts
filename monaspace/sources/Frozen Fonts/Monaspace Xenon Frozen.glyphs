e.left APLdeltaunderbar.left APLquaddel.left APLquaddelta.left colonequals.left equalsSignWithTwoDotsAboveAndTwoDotsBelow.left equalscolon.left equivalence.left equivalentWithFourDotsAbove.left gradient.left midlinehorizontalellipsis.left muchgreater.left muchless.left increment.left threeConsecutiveEqualsSigns.left tripleverticalbarrightturnstile.left twoConsecutiveEqualsSigns.left twoIntersectingLogicalAnd.left twoIntersectingLogicalOr.left twoLogicalAndOperator.left twoLogicalOrOperator.left verymuchgreaterthan.left verymuchlessthan.left leftRightArrow.left leftWaveArrow.left rightWaveArrow.left leftTwoheadedArrow.left rightTwoheadedArrow.left leftTailArrow.left rightTailArrow.left leftFrombarArrow.left rightFrombarArrow.left leftRightLongArrow.left percent.both perthousand.both at.both ampersand.both nAryCircledDotOperator.both nAryCircledPlusOperator.both nAryCircledTimesOperator.both APLdeldieresis.both APLdelstile.both APLdeltastile.both APLdeltaunderbar.both APLquaddel.both APLquaddelta.both colonequals.both equalsSignWithTwoDotsAboveAndTwoDotsBelow.both equalscolon.both equivalence.both equivalentWithFourDotsAbove.both gradient.both midlinehorizontalellipsis.both muchgreater.both muchless.both increment.both threeConsecutiveEqualsSigns.both tripleverticalbarrightturnstile.both twoConsecutiveEqualsSigns.both twoIntersectingLogicalAnd.both twoIntersectingLogicalOr.both twoLogicalAndOperator.both twoLogicalOrOperator.both verymuchgreaterthan.both verymuchlessthan.both leftRightArrow.both leftWaveArrow.both rightWaveArrow.both leftTwoheadedArrow.both rightTwoheadedArrow.both leftTailArrow.both rightTailArrow.both leftFrombarArrow.both rightFrombarArrow.both leftRightLongArrow.both];
@colon = [colon colon_colon colon_colon_colon];

sub colon by colon.case;
sub exclamdown by exclamdown.case;
sub questiondown by questiondown.case;
sub invertedinterrobang by invertedinterrobang.case;




# LIGA Features

lookup period_period_period {
  # Contextual substitution for '...' not followed or preceded by '.'.
  ignore sub period period' period period;
  ignore sub period' period period period;
  ignore sub period period' period period period;
  sub period' period' period' by period_period_period;
} period_period_period;

lookup semicolon_semicolon_semicolon {
  # Contextual substitution for ';;;' not followed or preceded by ';'.
  ignore sub semicolon semicolon' semicolon semicolon;
  ignore sub semicolon' semicolon semicolon semicolon;
  ignore sub semicolon semicolon' semicolon semicolon semicolon;
  sub semicolon' semicolon' semicolon' by semicolon_semicolon_semicolon;
} semicolon_semicolon_semicolon;

lookup semicolon_semicolon {
  # Contextual substitution for ';;' not followed or preceded by ';'.
  ignore sub semicolon semicolon' semicolon;
  ignore sub semicolon' semicolon semicolon;
  ignore sub semicolon semicolon' semicolon semicolon;
  sub semicolon' semicolon' by semicolon_semicolon;
} semicolon_semicolon;

lookup slash_slash_slash {
  # Contextual substitution for '///' not followed or preceded by '/'.
  ignore sub slash slash' slash slash;
  ignore sub slash' slash slash slash;
  ignore sub slash slash' slash slash slash;
  sub slash' slash' slash' by slash_slash_slash;
} slash_slash_slash;

lookup slash_slash {
  # Contextual substitution for '//' not followed or preceded by '/'.
  ignore sub slash slash' slash;
  ignore sub slash' slash slash;
  ignore sub slash slash' slash slash;
  sub slash' slash' by slash_slash;
} slash_slash;

lookup bar_bar {
  # Contextual substitution for '||' not followed or preceded by '|'.
  ignore sub bar bar' bar;
  ignore sub bar' bar bar;
  ignore sub bar bar' bar bar;
  sub bar' bar' by bar_bar;
} bar_bar;

lookup exclam_exclam {
  # Contextual substitution for '!!' not followed or preceded by '!'.
  ignore sub exclam exclam' exclam;
  ignore sub exclam' exclam exclam;
  ignore sub exclam exclam' exclam exclam;
  sub exclam' exclam' by exclam_exclam;
} exclam_exclam;




# SS01 Features

lookup equal_equal_equal {
  # Contextual substitution for '===' not followed or preceded by '='.
  ignore sub equal equal' equal equal;
  ignore sub equal' equal equal equal;
  sub equal' equal' equal' by equal_equal_equal;
} equal_equal_equal;

lookup exclam_equal_equal {
  # Contextual substitution for '!==' not followed by '='.
  ignore sub exclam' equal equal equal;
  sub exclam' equal' equal' by exclam_equal_equal;
} exclam_equal_equal;

lookup equal_exclam_equal {
    # Contextual substitution for '=!=' not followed or preceded by '=' or '!'.
    ignore sub equal' exclam equal [equal exclam];
    ignore sub [equal exclam] equal' exclam equal;
    sub equal' exclam' equal' by equal_exclam_equal;
} equal_exclam_equal;

lookup equal_slash_equal {
  # Contextual substitution for '=/=' not followed or preceded by '='.
  ignore sub equal equal' slash equal;
  ignore sub equal' slash equal equal;
  sub equal' slash' equal' by equal_slash_equal;
} equal_slash_equal;

lookup slash_equal_equal {
  # Contextual substitution for '/==' not followed by '='.
  ignore sub slash' equal equal equal;
  sub slash' equal' equal' by slash_equal_equal;
} slash_equal_equal;

lookup slash_equal {
  # Contextual substitution for '/='.
  sub slash' equal' by slash_equal;
} slash_equal;

lookup numbersign_equal {
  # Contextual substitution for '#='.
  sub numbersign' equal' by numbersign_equal;
} numbersign_equal;

lookup ampersand_equal {
  # Contextual substitution for '&='.
  sub [ampersand ampersand.left ampersand.right ampersand.both]' equal' by ampersand_equal;
} ampersand_equal;

lookup equal_equal {
  # Contextual substitution for '==' not followed or preceded by '='.
  ignore sub equal equal' equal;
  ignore sub equal' equal equal;
  sub equal' equal' by equal_equal;
} equal_equal;

lookup exclam_equal {
  # Contextual substitution for '!=' not followed by '='.
  ignore sub exclam' equal equal;
  sub exclam' equal' by exclam_equal;
} exclam_equal;

lookup asciitilde_asciitilde {
  # Contextual substitution for '~~' not followed or preceded by '~', '<' or '>'.
  ignore sub asciitilde' asciitilde asciitilde;
  ignore sub asciitilde asciitilde' asciitilde;
  ignore sub asciitilde' asciitilde [greater less];
  ignore sub [greater less] asciitilde' asciitilde;
  sub asciitilde' asciitilde' by asciitilde_asciitilde;
} asciitilde_asciitilde;

lookup equal_asciitilde {
  # Contextual substitution for '=~' not preceded by '=' or followed by '~'.
	ignore sub equal equal' asciitilde;
	ignore sub equal' asciitilde asciitilde;
	ignore sub slash equal' asciitilde;
	ignore sub equal' asciitilde slash;
	sub equal' asciitilde' by equal_asciitilde;
} equal_asciitilde;

lookup exclam_asciitilde {
  # Contextual substitution for '!~' not followed by '~'.
  ignore sub exclam' asciitilde asciitilde;
	sub exclam' asciitilde' by exclam_asciitilde;
} exclam_asciitilde;

lookup asciitilde_hyphen {
  # Contextual substitution for '~-' not followed or preceded by '~' or '-'.
  ignore sub [asciitilde hyphen] asciitilde' hyphen';
  ignore sub asciitilde' hyphen' [asciitilde hyphen];
	sub asciitilde' hyphen' by asciitilde_hyphen;
} asciitilde_hyphen;

lookup hyphen_asciitilde {
  # Contextual substitution for '-~' not followed or preceded by '~' or '-'.
  ignore sub [asciitilde hyphen] hyphen' asciitilde';
  ignore sub hyphen' asciitilde' [asciitilde hyphen];
	sub hyphen' asciitilde' by hyphen_asciitilde;
} hyphen_asciitilde;




# SS02 Features

lookup greater_equal {
    # Contextual substitution for '>=' not followed by '=' and not preceded or followed by '>'.
    ignore sub greater' equal' [greater less equal];
    ignore sub greater greater' equal';
    sub greater' equal' by greater_equal;
} greater_equal;

lookup less_equal {
    # Contextual substitution for '<=' not followed by '=' and not part of '<=>'.
    ignore sub less' equal' [greater less equal];
    ignore sub less less' equal';
    ignore sub less_equal.alt';
    sub less' equal' by less_equal;
} less_equal;




# SS03 Features

lookup less_hyphen_hyphen_greater {
    # Contextual substitution for '<-->' not followed by '>' or preceded by '<'.
    ignore sub less less' hyphen hyphen greater;
    ignore sub less' hyphen hyphen greater greater;
    sub less' hyphen' hyphen' greater' by less_hyphen_hyphen_greater;
} less_hyphen_hyphen_greater;

lookup less_exclam_hyphen_hyphen {
    # Contextual substitution for '<!--' not followed by '-' or preceded by '<'.
    ignore sub less less' exclam hyphen hyphen;
    ignore sub less' exclam hyphen hyphen hyphen;
    sub less' exclam' hyphen' hyphen' by less_exclam_hyphen_hyphen;
} less_exclam_hyphen_hyphen;

lookup less_hyphen_hyphen {
    # Contextual substitution for '<--' not followed by '-' or '>', or preceded by '<'.
    ignore sub less less' hyphen hyphen;
    ignore sub less' hyphen hyphen hyphen;
    ignore sub less' hyphen hyphen greater;
    sub less' hyphen' hyphen' by less_hyphen_hyphen;
} less_hyphen_hyphen;

lookup hyphen_hyphen_greater {
    # Contextual substitution for '-->' not preceded by '-' or '<', or followed by '>'.
    ignore sub hyphen' hyphen greater greater;
    ignore sub hyphen hyphen' hyphen greater;
    ignore sub less hyphen' hyphen greater;
    sub hyphen' hyphen' greater' by hyphen_hyphen_greater;
} hyphen_hyphen_greater;

lookup less_hyphen_greater {
    # Contextual substitution for '<->' not followed by '>' or preceded by '<'.
    ignore sub less less' hyphen greater;
    ignore sub less' hyphen greater greater;
    sub less' hyphen' greater' by less_hyphen_greater;
} less_hyphen_greater;

lookup less_hyphen {
    # Contextual substitution for '<-' not followed by '>' or preceded by '<'.
    ignore sub less less' hyphen;
    ignore sub less' hyphen greater;
    sub less' hyphen' by less_hyphen;
} less_hyphen;

lookup hyphen_greater {
    # Contextual substitution for '->' not followed by '>' or preceded by '<'.
    ignore sub hyphen' greater greater;
    ignore sub less hyphen' greater;
    sub hyphen' greater' by hyphen_greater;
} hyphen_greater;

lookup less_asciitilde_asciitilde {
    # Contextual substitution for '<~~' not followed by '~' or '>', or preceded by '<'.
    ignore sub less less' asciitilde asciitilde;
    ignore sub less' asciitilde asciitilde asciitilde;
    ignore sub less' asciitilde asciitilde greater;
    sub less' asciitilde' asciitilde' by less_asciitilde_asciitilde;
} less_asciitilde_asciitilde;

lookup asciitilde_asciitilde_greater {
    # Contextual substitution for '~~>' not preceded by '~' or '<', or followed by '>'.
    ignore sub asciitilde' asciitilde greater greater;
    ignore sub asciitilde asciitilde' asciitilde greater;
    ignore sub less asciitilde' asciitilde greater;
    sub asciitilde' asciitilde' greater' by asciitilde_asciitilde_greater;
} asciitilde_asciitilde_greater;

lookup less_asciitilde_greater {
    # Contextual substitution for '<~>' not followed by '>' or preceded by '<'.
    ignore sub less less' asciitilde greater;
    ignore sub less' asciitilde greater greater;
    sub less' asciitilde' greater' by less_asciitilde_greater;
} less_asciitilde_greater;

lookup less_asciitilde {
    # Contextual substitution for '<~' not followed by '>' or preceded by '<'.
    ignore sub less less' asciitilde;
    ignore sub less' asciitilde greater;
    sub less' asciitilde' by less_asciitilde;
} less_asciitilde;

lookup asciitilde_greater {
    # Contextual substitution for '~>' not followed by '>' or preceded by '<'.
    ignore sub asciitilde' greater greater;
    ignore sub less asciitilde' greater;
    sub asciitilde' greater' by asciitilde_greater;
} asciitilde_greater;




# SS04 Features

lookup less_slash_greater {
    # Contextual substitution for '</>' not followed by '>' or preceded by '<'.
    ignore sub less less' slash greater;
    ignore sub less' slash greater greater;
    sub less' slash' greater' by less_slash_greater;
} less_slash_greater;

lookup less_slash {
    # Contextual substitution for '</' not followed by '>' or '/', or preceded by '<'.
    ignore sub less less' slash;
    ignore sub less' slash greater;
    ignore sub less' slash slash;
    sub less' slash' by less_slash;
} less_slash;

lookup slash_greater {
    # Contextual substitution for '/>' not followed by '>' or preceded by '<' or '/'.
    ignore sub slash' greater greater;
    ignore sub slash slash' greater;
    ignore sub less slash' greater;
    sub slash' greater' by slash_greater;
} slash_greater;

lookup less_greater {
    # Contextual substitution for '<>' not followed by '>' or preceded by '<'.
    ignore sub less less' greater;
    ignore sub less' greater greater;
    sub less' greater' by less_greater;
} less_greater;




# SS05 Features 

lookup slash_backslash {
    # Contextual substitution for '/\\' not followed by '\\' or preceded by '/'.
    ignore sub slash slash' backslash;
    ignore sub slash' backslash backslash;
    sub slash' backslash' by slash_backslash;
} slash_backslash;

lookup backslash_slash {
    # Contextual substitution for '\\/' not followed by '/' or preceded by '\\'.
    ignore sub backslash backslash' slash;
    ignore sub backslash' slash slash;
    sub backslash' slash' by backslash_slash;
} backslash_slash;

lookup less_bar_greater {
    # Contextual substitution for '<|>' not preceded by '<' or followed by '>'.
    ignore sub less' bar' greater' greater;
    ignore sub less less' bar' greater';
    sub less' bar' greater' by less_bar_greater;
} less_bar_greater;

lookup bar_greater {
    # Contextual substitution for '|>' not followed by '>'.
    ignore sub bar' greater greater;
    sub bar' greater' by bar_greater;
} bar_greater;

lookup less_bar {
    # Contextual substitution for '<|' not preceded by '<'.
    ignore sub less less' bar;
    sub less' bar' by less_bar;
} less_bar;

lookup bracketleft_bar {
    # Contextual substitution for '[|' not followed by '|' or preceded by '['.
    ignore sub bracketleft bracketleft' bar';
    ignore sub bracketleft' bar' bar;
    sub bracketleft' bar' by bracketleft_bar;
} bracketleft_bar;

lookup bar_bracketright {
    # Contextual substitution for '|]' not followed by ']' or preceded by '|'.
    ignore sub bar bar' bracketright';
    ignore sub bar' bracketright' bracketright;
    sub bar' bracketright' by bar_bracketright;
} bar_bracketright;

lookup braceleft_bar {
    # Contextual substitution for '{|' not followed by '|' or preceded by '{'.
    ignore sub braceleft braceleft' bar';
    ignore sub braceleft' bar' bar;
    sub braceleft' bar' by braceleft_bar;
} braceleft_bar;

lookup bar_braceright {
    # Contextual substitution for '|}' not followed by '}' or preceded by '|'.
    ignore sub bar bar' braceright';
    ignore sub bar' braceright' braceright;
    sub bar' braceright' by bar_braceright;
} bar_braceright;




# SS06 Features 

lookup plus.init {
    # Contextual substitution for '++' and '+++'.
    ignore sub @plus @plus';
    sub @plus' @plus by plus.init;
} plus.init;

lookup plus.fina {
    # Contextual substitution for '++' and '+++'.
    ignore sub @plus' @plus;
    sub @plus @plus' by plus.fina;
} plus.fina;

lookup plus.medi {
    # Contextual substitution for '+++'.
    sub @plus @plus' @plus by plus.medi;
} plus.medi;

lookup numbersign.init {
    # Contextual substitution for '##' and '###'.
    ignore sub @numbersign @numbersign';
    sub @numbersign' @numbersign by numbersign.init;
} numbersign.init;

lookup numbersign.fina {
    # Contextual substitution for '##' and '###'.
    ignore sub @numbersign' @numbersign;
    sub @numbersign @numbersign' by numbersign.fina;
} numbersign.fina;

lookup numbersign.medi {
    # Contextual substitution for '###'.
    sub @numbersign @numbersign' @numbersign by numbersign.medi;
} numbersign.medi;

lookup equal.medi {
    # Contextual substitution for '====='.
    sub @equal @equal' @equal @equal by equal.medi;
    sub @equal @equal @equal' @equal by equal.medi;
} equal.medi;

lookup underscore.init {
    # Contextual substitution for '__' and '___'.
    ignore sub @underscore @underscore';
    sub @underscore' @underscore by underscore.longright;
} underscore.init;

lookup underscore.fina {
    # Contextual substitution for '__' and '___'.
    ignore sub @underscore' @underscore;
    sub @underscore @underscore' by underscore.longleft;
} underscore.fina;

lookup underscore.medi {
    # Contextual substitution for '___'.
    sub @underscore @underscore' @underscore by underscore.longboth;
} underscore.medi;

lookup underscoredbl.init {
    # Contextual substitution for '‗‗' and '‗‗‗'.
    ignore sub @underscoredbl @underscoredbl';
    sub @underscoredbl' @underscoredbl by underscoredbl.longright;
} underscoredbl.init;

lookup underscoredbl.fina {
    # Contextual substitution for '‗‗' and '‗‗‗'.
    ignore sub @underscoredbl' @underscoredbl;
    sub @underscoredbl @underscoredbl' by underscoredbl.longleft;
} underscoredbl.fina;

lookup underscoredbl.medi {
    # Contextual substitution for '‗‗‗'.
    sub @underscoredbl @underscoredbl' @underscoredbl by underscoredbl.longboth;
} underscoredbl.medi;

lookup ampersand_ampersand {
    # Contextual substitution for '&&' and '&&&'
    sub [ampersand ampersand.left ampersand.right ampersand.both]' [ampersand ampersand.left ampersand.right ampersand.both ampersand.init] by ampersand.init;
    sub [ampersand ampersand.left ampersand.right ampersand.both]' emptyAdvanceWidth ampersand_equal by ampersand.init;
} ampersand_ampersand;




# SS07 Features

lookup colon_math {
    # Contextual substitution for ':(raised)'.
    sub @math colon' by colon.raised;
    sub colon' @math by colon.raised;
    sub colon' emptyAdvanceWidth @math by colon.raised;
    sub colon' emptyAdvanceWidth emptyAdvanceWidth @math by colon.raised;
} colon_math;

lookup semicolon_check {
    # Contextual substitution for ':(lowered)' when preceded or followed by a semicolon.
    sub colon.raised' semicolon by colon;
    sub semicolon colon.raised' by colon;
} semicolon_check;

lookup colon_raised {
    # Contextual substitution for ':(raised)' when preceded or followed by another ':(raised)'.
    ignore sub colon.raised colon' semicolon;
    ignore sub semicolon colon' colon.raised;
    sub colon.raised colon' by colon.raised;
    sub colon' colon.raised by colon.raised;
} colon_raised;

lookup colon_raised2 {
    # Contextual substitution for ':(raised)' when preceded or followed by another ':(raised)'.
    ignore sub colon.raised colon' semicolon;
    ignore sub semicolon colon' colon.raised;
    sub colon.raised colon' by colon.raised;
    sub colon' colon.raised by colon.raised;
} colon_raised2;

lookup colon_raised3 {
    # Contextual substitution for ':(raised)' when preceded or followed by another ':(raised)'.
    ignore sub colon.raised colon' semicolon;
    ignore sub semicolon colon' colon.raised;
    sub colon.raised colon' by colon.raised;
    sub colon' colon.raised by colon.raised;
} colon_raised3;

lookup colon_raised4 {
    # Contextual substitution for ':(raised)' when preceded or followed by another ':(raised)'.
    ignore sub colon.raised colon' semicolon;
    ignore sub semicolon colon' colon.raised;
    sub colon.raised colon' by colon.raised;
    sub colon' colon.raised by colon.raised;
} colon_raised4;

lookup colon_check {
    # Contextual substitution for ':(lowered)' when preceded or followed by another ':(lowered)'.
    sub colon.raised' @colon by colon;
    sub @colon colon.raised' by colon;
} colon_check;

lookup colon_check2 {
    # Contextual substitution for ':(lowered)' when preceded or followed by another ':(lowered)'.
    sub colon.raised' @colon by colon;
    sub @colon colon.raised' by colon;
} colon_check2;

lookup colon_check3 {
    # Contextual substitution for ':(lowered)' when preceded or followed by another ':(lowered)'.
    sub colon.raised' @colon by colon;
    sub @colon colon.raised' by colon;
} colon_check3;

lookup colon_check4 { 
    # Contextual substitution for ':(lowered)' when preceded or followed by another ':(lowered)'.
    sub colon.raised' @colon by colon;
    sub @colon colon.raised' by colon;
} colon_check4;

lookup colon_colon_colon {
  # Contextual substitution for ':::' not followed or preceded by ':' or ';'.
  ignore sub [colon colon.raised semicolon] colon' colon colon;
  ignore sub colon' colon colon [colon colon.raised semicolon];
  sub colon' colon' colon' by colon_colon_colon;
} colon_colon_colon;

lookup colon_colon {
    # Contextual substitution for '::' not preceded or followed by ':' or ';'.
    ignore sub [colon colon.raised semicolon] colon' colon;
    ignore sub colon' colon [colon colon.raised semicolon];
    sub colon' colon' by colon_colon;
} colon_colon;




# SS08 Features

lookup period_period_equal {
    # Contextual substitution for '..=' not preceded by '.'.
    ignore sub period period' period' equal;
    sub period' period equal by period.raised;
    sub period.raised period' equal by period.raised;
} period_period_equal;

lookup period_period_hyphen {
    # Contextual substitution for '..-' not preceded by '.'.
    ignore sub period period' period' hyphen;
    sub period' period hyphen by period.raised;
    sub period.raised period' hyphen by period.raised;
} period_period_hyphen;

lookup period_period_less {
    # Contextual substitution for '..<' not preceded by '.'.
    ignore sub period period' period' less;
    sub period' period less by period.raised;
    sub period.raised period' less by period.raised;
} period_period_less;

lookup period_hyphen {
    # Contextual substitution for '.-' not preceded by '.'.
    ignore sub period period' hyphen;
    sub period' hyphen by period.raised;
} period_hyphen;

lookup period_equal {
    # Contextual substitution for '.=' not preceded by '.'.
    ignore sub period period' equal;
    sub period' equal by period.raised;
} period_equal;

lookup period_period {
    # Contextual substitution for '..' not preceded or followed by '.'.
    ignore sub period period' period;
    ignore sub period' period period;
    sub period' period' by period_period;
} period_period;




# SS09 Features

lookup less_equal_equal_greater {
    # Contextual substitution for '<==>' not followed by '>' or preceded by '<'.
    ignore sub less' equal equal greater greater;
    ignore sub less less' equal equal greater;
    sub less' equal' equal' greater' by less_equal_equal_greater;
    sub less' emptyAdvanceWidth' equal_equal' greater' by less_equal_equal_greater;
} less_equal_equal_greater;

lookup less_equal_equal {
    # Contextual substitution for '<==' not followed by '=' or preceded by '<'.
    ignore sub less' equal equal equal;
    ignore sub less' emptyAdvanceWidth equal_equal equal;
    ignore sub less less' equal equal;
    ignore sub less less' equal_equal;
    sub less' equal' equal' by less_equal_equal;
    sub less' emptyAdvanceWidth' equal_equal' by less_equal_equal;
} less_equal_equal;

lookup equal_equal_greater {
    # Contextual substitution for '==>' not preceded by '=' or followed by '>'.
    ignore sub equal equal' equal greater;
    ignore sub equal emptyAdvanceWidth equal_equal' greater;
    ignore sub equal' equal greater greater;
    ignore sub equal_equal' greater greater;
    sub equal' equal' greater' by equal_equal_greater;
    sub emptyAdvanceWidth' equal_equal' greater' by equal_equal_greater;
} equal_equal_greater;

lookup less_less_equal {
    # Contextual substitution for '<<=' not followed by '=' or preceded by '<'.
    ignore sub less' less equal equal;
    ignore sub less less' less equal;
    sub less' less' equal' by less_less_equal;
} less_less_equal;

lookup equal_greater_greater {
    # Contextual substitution for '=>>' not preceded by '=' or followed by '>'.
    ignore sub equal equal' greater greater;
    ignore sub equal' greater greater greater;
    sub equal' greater' greater' by equal_greater_greater;
} equal_greater_greater;

lookup equal_less_less {
    # Contextual substitution for '=<<' not preceded by '=' or followed by '<'.
    ignore sub less' less equal equal;
    ignore sub less less' less equal;
    sub equal' less' less' by equal_less_less;
} equal_less_less;

lookup greater_greater_equal {
    # Contextual substitution for '>>=' not followed by '=' or preceded by '>'.
    ignore sub greater greater' greater equal;
    ignore sub greater' greater equal equal;
    sub greater' greater' equal' by greater_greater_equal;
} greater_greater_equal;

lookup less_less {
    # Contextual substitution for '<<' not followed or preceded by '<'.
    ignore sub less less' less;
    ignore sub less' less less;
    sub less' less' by less_less;
} less_less;

lookup greater_greater {
    # Contextual substitution for '>>' not followed or preceded by '>'.
    ignore sub greater greater' greater;
    ignore sub greater' greater greater;
    sub greater' greater' by greater_greater;
} greater_greater;

lookup less_equal_greater {
    # Contextual substitution for '<=>' not followed by '>' or preceded by '<'.
    ignore sub less less' equal greater;
    ignore sub less' equal greater greater;
    sub less' equal' greater' by less_equal_greater;
} less_equal_greater;

lookup equal_greater {
    # Contextual substitution for '=>' not preceded by '=' and not part of '<=>'.
    ignore sub less equal' greater;
    ignore sub equal equal' greater;
    ignore sub equal' greater greater;
    sub equal' greater' by equal_greater;
} equal_greater;




# SS10 Features

lookup numbersign_exclam_bracketleft {
    # Contextual substitution for '#![' when not preceded by '#'.
    ignore sub numbersign numbersign' exclam bracketleft;
    sub numbersign' exclam' bracketleft' by numbersign_exclam_bracketleft;
} numbersign_exclam_bracketleft;

lookup numbersign_bracketleft {
    # Contextual substitution for '#[' when not preceded by '#'.
    ignore sub numbersign numbersign' bracketleft';
    sub numbersign' bracketleft' by numbersign_bracketleft;
} numbersign_bracketleft;

lookup numbersign_parenleft {
    # Contextual substitution for '#(' when not preceded by '#'.
    ignore sub numbersign numbersign' parenleft';
    sub numbersign' parenleft' by numbersign_parenleft;
} numbersign_parenleft;




