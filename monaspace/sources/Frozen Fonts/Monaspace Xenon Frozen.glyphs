@can_take_space_right = [w.right wacute.right wcircumflex.right wdieresis.right wgrave.right omega.right omegatonos.right wturned.right m.right m.italic.right sha-cy.right sha-cy.italic.right sha-cy.loclBGR.right sha-cy.loclBGR.italic.right shcha-cy.right shcha-cy.italic.right shcha-cy.loclBGR.right shcha-cy.loclBGR.italic.right psi.right mhook.right mlonglegturned.right mmiddletilde.right mturned.right ae.right aeacute.right oe.right ij.right OEsmall.right dezh.right dzaltone.right dzcurl.right fengdigraph.right lezh.right lsdigraph.right lzdigraph.right tccurl.right tesh.right ts.right em-cy.right em-cy.italic.right hardsign-cy.right hardsign-cy.italic.right hardsign-cy.loclBGR.right ef-cy.right yu-cy.right yu-cy.italic.right yu-cy.loclBGR.right yu-cy.loclBGR.italic.right phi.right phi-latin.right zhe-cy.right zhe-cy.italic.right zhe-cy.loclBGR.right zhe-cy.loclBGR.italic.right zhedescender-cy.right zhedescender-cy.italic.right yeru-cy.right yeru-cy.italic.right lje-cy.right lje-cy.italic.right nje-cy.right nje-cy.italic.right W.right Wacute.right Wcircumflex.right Wdieresis.right Wgrave.right won.right won.nobar.right M.right Em-cy.right Mu.right T.right Tbar.right Tcaron.right Tcedilla.right Tcommaaccent.right Te-cy.right Tau.right AE.right AEacute.right OE.right De-cy.right De-cy.loclBGR.right Hardsign-cy.right Tshe-cy.right Dje-cy.right Ef-cy.right Ef-cy.loclBGR.right Phi.right Psi.right Yeru-cy.right Lje-cy.right Nje-cy.right Yu-cy.right Zhe-cy.right Zhedescender-cy.right Sha-cy.right Shcha-cy.right Epsilontonos.right Etatonos.right Iotatonos.right Omicrontonos.right Upsilontonos.right Omegatonos.right numero.right centigrade.right fahrenheit.right kelvin.right exclamationquestion.right exclamdouble.right doublequestion.right questionexclamation.right heavySingleTurnedCommaQuotationMarkOrnament.right heavySingleCommaQuotationMarkOrnament.right heavyDoubleTurnedCommaQuotationMarkOrnament.right heavyDoubleCommaQuotationMarkOrnament.right trademark.right servicemark.right percent.right perthousand.right at.right ampersand.right nAryCircledDotOperator.right nAryCircledPlusOperator.right nAryCircledTimesOperator.right APLdeldieresis.right APLdelstile.right APLdeltastile.right APLdeltaunderbar.right APLquaddel.right APLquaddelta.right colonequals.right equalsSignWithTwoDotsAboveAndTwoDotsBelow.right equalscolon.right equivalence.right equivalentWithFourDotsAbove.right gradient.right midlinehorizontalellipsis.right muchgreater.right muchless.right increment.right threeConsecutiveEqualsSigns.right tripleverticalbarrightturnstile.right twoConsecutiveEqualsSigns.right twoIntersectingLogicalAnd.right twoIntersectingLogicalOr.right twoLogicalAndOperator.right twoLogicalOrOperator.right verymuchgreaterthan.right verymuchlessthan.right leftRightArrow.right leftWaveArrow.right rightWaveArrow.right leftTwoheadedArrow.right rightTwoheadedArrow.right leftTailArrow.right rightTailArrow.right leftFrombarArrow.right rightFrombarArrow.right leftRightLongArrow.right];
@can_take_space_both = [w.both wacute.both wcircumflex.both wdieresis.both wgrave.both omega.both omegatonos.both wturned.both m.both m.italic.both sha-cy.both sha-cy.italic.both sha-cy.loclBGR.both sha-cy.loclBGR.italic.both shcha-cy.both shcha-cy.italic.both shcha-cy.loclBGR.both shcha-cy.loclBGR.italic.both psi.both mhook.both mlonglegturned.both mmiddletilde.both mturned.both ae.both aeacute.both oe.both ij.both OEsmall.both dezh.both dzaltone.both dzcurl.both fengdigraph.both lezh.both lsdigraph.both lzdigraph.both tccurl.both tesh.both ts.both em-cy.both em-cy.italic.both hardsign-cy.both hardsign-cy.italic.both hardsign-cy.loclBGR.both ef-cy.both yu-cy.both yu-cy.italic.both yu-cy.loclBGR.both yu-cy.loclBGR.italic.both phi.both phi-latin.both zhe-cy.both zhe-cy.italic.both zhe-cy.loclBGR.both zhe-cy.loclBGR.italic.both zhedescender-cy.both zhedescender-cy.italic.both yeru-cy.both yeru-cy.italic.both lje-cy.both lje-cy.italic.both nje-cy.both nje-cy.italic.both W.both Wacute.both Wcircumflex.both Wdieresis.both Wgrave.both won.both won.nobar.both M.both Em-cy.both Mu.both T.both Tbar.both Tcaron.both Tcedilla.both Tcommaaccent.both Te-cy.both Tau.both AE.both AEacute.both OE.both De-cy.both De-cy.loclBGR.both Hardsign-cy.both Tshe-cy.both Dje-cy.both Ef-cy.both Ef-cy.loclBGR.both Phi.both Psi.both Yeru-cy.both Lje-cy.both Nje-cy.both Yu-cy.both Zhe-cy.both Zhedescender-cy.both Sha-cy.both Shcha-cy.both Epsilontonos.both Etatonos.both Iotatonos.both Omicrontonos.both Upsilontonos.both Omegatonos.both numero.both centigrade.both fahrenheit.both kelvin.both exclamationquestion.both exclamdouble.both doublequestion.both questionexclamation.both heavySingleTurnedCommaQuotationMarkOrnament.both heavySingleCommaQuotationMarkOrnament.both heavyDoubleTurnedCommaQuotationMarkOrnament.both heavyDoubleCommaQuotationMarkOrnament.both trademark.both servicemark.both percent.both perthousand.both at.both ampersand.both nAryCircledDotOperator.both nAryCircledPlusOperator.both nAryCircledTimesOperator.both APLdeldieresis.both APLdelstile.both APLdeltastile.both APLdeltaunderbar.both APLquaddel.both APLquaddelta.both colonequals.both equalsSignWithTwoDotsAboveAndTwoDotsBelow.both equalscolon.both equivalence.both equivalentWithFourDotsAbove.both gradient.both midlinehorizontalellipsis.both muchgreater.both muchless.both increment.both threeConsecutiveEqualsSigns.both tripleverticalbarrightturnstile.both twoConsecutiveEqualsSigns.both twoIntersectingLogicalAnd.both twoIntersectingLogicalOr.both twoLogicalAndOperator.both twoLogicalOrOperator.both verymuchgreaterthan.both verymuchlessthan.both leftRightArrow.both leftWaveArrow.both rightWaveArrow.both leftTwoheadedArrow.both rightTwoheadedArrow.both leftTailArrow.both rightTailArrow.both leftFrombarArrow.both rightFrombarArrow.both leftRightLongArrow.both];
@stationary = [period comma parenleft parenright braceleft braceright bracketleft bracketright];


		
lookup defaultLeftPass {
    #if a glyph that can take space is to the left of a glyph that can give space, cause the glyph that can give space to extend to the right
    #sample: im = i.left m;
    sub @defaults_can_give_space' @defaults_can_take_space by @can_give_space_left;
} defaultLeftPass;

lookup defaultRightPass {
    #if a glyph that can take space is to the right of a glyph that can give space, cause the glyph that can give space to extend to the left
    #sample: ml = m l.right;
    sub @defaults_can_take_space @defaults_can_give_space' by @can_give_space_right;
} defaultRightPass;

lookup centerPass {
    #if a glyph that can take space is between two glyphs that can give space, cause the glyph that can take space to extend in both directions outwards
    #this also requires that the 1st and 3rd glyphs have already been swapped to .left and .right respectively by the defaultLeftPass and defaultRightPass lookups
    #sample: iml = i.left m.both l.right;
    sub @can_give_space_left @defaults_can_take_space' @can_give_space_right by @can_take_space_both;
} centerPass;



lookup secondLeftPass {
    #if a glyph was swapped to a .left and is followed by a glyph that can take space, cause the glyph that can take space to extend to the left
    #sample i.left m = i.left m.right;
    sub @can_give_space_left @defaults_can_take_space' by @can_take_space_left;
} secondLeftPass;

lookup secondRightPass {
    #if a glyph was swapped to a .right and is preceded by a glyph that can take space, cause the glyph that can take space to extend to the right
    #sample m l.right = m.left l.right;
    sub @defaults_can_take_space' @can_give_space_right by @can_take_space_right;
} secondRightPass;




lookup stationaryLeftPass {
	#some glyphs like the period can remain stationary because they have tons of space on both sides, while glyphs on the left of them can take space, they will not be moved
	#sample period m = period m.right;
	sub @stationary @defaults_can_take_space' by @can_take_space_left;
} stationaryLeftPass;

lookup stationaryRightPass {
	#some glyphs like the period can remain stationary because they have tons of space on both sides, while glyphs on the right of them can take space, they will not be moved
	#sample m period = m.left period;
	sub @defaults_can_take_space' @stationary by @can_take_space_right;
} stationaryRightPass;


lookup stationaryLeftSecondPass {
	#for a string such as i.left m.left period, the period can stay stationary and the m.left can become m.both
	#sample i.left m.left period = i.left m.both period;
    sub @can_give_space_left @can_take_space_left' @stationary by @can_take_space_both;
} stationaryLeftSecondPass;

lookup stationaryRightSecondPass {
	#for a string such as period m.right l.right, the period can stay stationary and the m.right can become m.both
	#sample period m.right l.right = period m.both l.right;
	sub @stationary @can_take_space_right' @can_give_space_right by @can_take_space_both;
} stationaryRightSecondPass;

lookup stationaryCenterPass {
	#ultimately we want a string like \"period m period\" to become \"period m.both period\"
	#as a result of earlier lookups, the string could initially be something like period m.left period
	#or it could be period m.right period
	#this lookup will take care of both cases
	#sample period m.left period = period m.both period;
	sub @stationary @can_take_space_both' @stationary by @can_take_space_both;
	sub @stationary @can_take_space_left' @stationary by @can_take_space_both;
	sub @stationary @can_take_space_right' @stationary by @can_take_space_both;
} stationaryCenterPass;

		



#ifdef VARIABLE


lookup defaultLeftPass;
lookup defaultRightPass;
lookup centerPass;

lookup secondLeftPass;
lookup secondRightPass;

lookup stationaryLeftPass;
lookup stationaryRightPass;
lookup stationaryLeftSecondPass;
lookup stationaryRightSecondPass;
lookup stationaryCenterPass;
		
		

